    printf("Enter Choice: ");
    scanf("%d", &choice);
    
    if(choice == 1){
        answer = num1 + num2;
        printf("%.2f + %.2f is equal to %.2f", num1, num2, answer);
    } else if(choice == 2){
        answer = num1 - num2;
        printf("%.2f - %.2f is equal to %.2f", num1, num2, answer);
