        answer = num1 * num2;
        printf("%.2f * %.2f is equal to %.2f", num1, num2, answer);
    } else if(choice == 4){
        if(num2 != 0){
            answer = num1 / num2;
            printf("%.2f / %.2f is equal to %.2f", num1, num2, answer);
        }else{
            printf("You can't divide by 0");
        }
    } else if(choice == 5){
        if(num2 != 0){
            answer = fmod(num1, num2);
            printf("%.2f %% %.2f is equal to %.2f", num1, num2, answer);
        }else{
            printf("You can't get a remainder with 0");
        } 
    } else{
        printf("Invalid Choice");
    }
    
    return 0;
}
